use career_guidance;
CREATE TABLE departments (
    id INT AUTO_INCREMENT PRIMARY KEY,
    department_code VARCHAR(10) NOT NULL,
    department_name VARCHAR(150) NOT NULL
);
delete from departments;
SET SQL_SAFE_UPDATES = 0;
DELETE FROM departments;
SET SQL_SAFE_UPDATES = 1;

SELECT id, name FROM colleges
WHERE name IN (
    'College of Engineering, Guindy',
    'Thanthai Periyar Government Institute of Technology (TPGIT)',
    'Madras Medical College',
    'Tamil Nadu Agricultural University',
    'Government Law College',
    'Presidency College'
);
DELETE FROM colleges
WHERE id IN (1, 2, 3, 4, 5, 6);
DESCRIBE colleges;

ALTER TABLE colleges
ADD COLUMN college_code VARCHAR(20) AFTER id;
UPDATE colleges
SET college_code = CONCAT('OLD', id)
WHERE name IN (
    'College of Engineering, Guindy',
    'Thanthai Periyar Government Institute of Technology (TPGIT)',
    'Madras Medical College',
    'Tamil Nadu Agricultural University',
    'Government Law College',
    'Presidency College'
);
ALTER TABLE colleges
MODIFY COLUMN college_code VARCHAR(20) NOT NULL UNIQUE;
