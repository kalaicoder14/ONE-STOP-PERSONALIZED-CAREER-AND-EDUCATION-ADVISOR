SELECT id, name
FROM colleges
WHERE name IN (
    'College of Engineering, Guindy',
    'Thanthai Periyar Government Institute of Technology (TPGIT)',
    'Madras Medical College',
    'Tamil Nadu Agricultural University',
    'Government Law College',
    'Presidency College'
);
ALTER TABLE colleges
ADD COLUMN status VARCHAR(20) DEFAULT 'active';

UPDATE colleges
SET status = 'inactive'
WHERE id IN (1, 2, 3, 4, 5, 6);

select * from colleges;
SELECT id, name, college_code
FROM colleges
WHERE college_code IS NULL;

DELETE FROM colleges
WHERE id IN (1, 2, 3, 4, 5, 6);

CREATE TABLE colleges_temp (
    id INT AUTO_INCREMENT PRIMARY KEY,
    college_code VARCHAR(20) NOT NULL UNIQUE,
    name VARCHAR(255) NOT NULL,
    district VARCHAR(255) NOT NULL,
    category VARCHAR(100),
    status VARCHAR(20) DEFAULT 'active'
);

INSERT INTO colleges_temp (college_code, name, district, category, status)
SELECT college_code, name, district, category, status
FROM colleges
WHERE status = 'active';

